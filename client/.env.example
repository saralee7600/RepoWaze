
# Backend base URL (inlined at build time - redeploy after changing).
# Production: https://repowaze.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:3000

# Public URL of this Next.js app.
# Production: https://repo-waze-three.vercel.app
NEXTAUTH_URL=http://localhost:3001

# Required in production. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=NEXTAUTH_SECRET

GOOGLE_CLIENT_ID=GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=GOOGLE_CLIENT_SECRET
