# Copy to `.env` (or `.env.local`) and fill in the values. Never commit real secrets.

# Base URL of the NestJS API.
NEXT_PUBLIC_API_URL=http://localhost:3000

# Public URL of this app; Google must list `${NEXTAUTH_URL}/api/auth/callback/google` as a redirect URI.
NEXTAUTH_URL=http://localhost:3001
# Signs the session cookie. Generate one with: openssl rand -base64 32
NEXTAUTH_SECRET=

# OAuth 2.0 Web client from https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=GOOGLE_CLIENT_SECRET
