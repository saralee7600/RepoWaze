# Copy to `.env` and fill in the values. Never commit real secrets.

PORT=3000

DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASS=
DB_NAME=

# Optional: raises the GitHub API rate limit when importing repositories.
GITHUB_TOKEN=

# Must be the SAME Google OAuth client id the web app signs in with:
# the API only accepts ID tokens issued for this audience.
GOOGLE_CLIENT_ID=
